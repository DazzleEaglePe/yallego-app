<?xml version="1.0" encoding="utf-8"?>
<!-- Política base incluida en release: solo TLS y certificados del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
