{
  "name": "yallego",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "postcss": "8.5.26"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @yallego/api dev",
    "dev:dashboard": "pnpm --filter @yallego/dashboard dev",
    "dev:stack": "turbo run dev --filter=@yallego/api --filter=@yallego/dashboard",
    "db:generate": "pnpm --filter @yallego/api db:generate",
    "db:migrate": "pnpm --filter @yallego/api db:migrate",
    "db:deploy": "pnpm --filter @yallego/api db:deploy",
    "db:seed": "pnpm --filter @yallego/api db:seed",
    "db:validate": "pnpm --filter @yallego/api db:validate",
    "docker:up": "docker compose -f tools/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f tools/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f tools/docker/docker-compose.yml logs -f",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t yallego-api:local .",
    "docker:build:dashboard": "docker build -f apps/dashboard/Dockerfile -t yallego-dashboard:local .",
    "docker:build": "pnpm docker:build:api && pnpm docker:build:dashboard"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
