NODE_ENV=development
PORT=3001

# La aplicación se conecta con un rol sin BYPASSRLS para que Row Level Security
# se evalúe de verdad. Las migraciones y la semilla usan el rol propietario.
DATABASE_URL=postgresql://yallego_app:yallego_app_dev@localhost:5432/yallego
DIRECT_DATABASE_URL=postgresql://yallego:yallego_dev@localhost:5432/yallego
REDIS_URL=redis://localhost:6379

# Base64-encoded PEM keys. Generate local keys with tools/scripts/generate-jwt-keys.sh.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=yallego-dashboard

# 32 random bytes encoded as base64.
ENCRYPTION_KEY=

WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@yallego.app

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

DASHBOARD_URL=http://localhost:3000
SENTRY_DSN=
# Desarrollo: debug. Producción: info (debug/trace son rechazados al iniciar).
LOG_LEVEL=debug
# Vacío = las trazas se generan pero no se exportan a ningún colector (RNF-OBS-003).
OTEL_EXPORTER_OTLP_ENDPOINT=
# RNF-OBS-004/005: umbrales de las alertas de plataforma. Se omiten aquí a
# propósito (no dejar como `CLAVE=` vacío: al ser numéricas, una cadena
# vacía se interpretaría como 0, no como "usar el valor por defecto") — sin
# definirlas, `env.schema.ts` aplica sus valores por defecto.
# PARSING_SUCCESS_RATE_ALERT_THRESHOLD=0.95
# PARSING_ALERT_MIN_SAMPLE_SIZE=20
# WEBHOOK_QUEUE_DEPTH_ALERT_THRESHOLD=200

NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=Yallegó
