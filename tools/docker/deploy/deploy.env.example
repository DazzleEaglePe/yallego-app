# Identidad del entorno
DEPLOY_ENV=staging
SERVER_NAME=staging.example.com
PUBLIC_URL=https://staging.example.com

# Solo el proxy publica puertos. Para un smoke local pueden usarse 3080/3443.
HTTP_PORT=80
HTTPS_PORT=443
TLS_FULLCHAIN_PATH=/etc/letsencrypt/live/staging.example.com/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/staging.example.com/privkey.pem

# Imágenes inmutables. En un servidor deben apuntar al registro y a un tag o
# digest concreto, nunca a latest.
API_IMAGE=registry.example.com/yallego/api:REPLACE_WITH_RELEASE
MIGRATIONS_IMAGE=registry.example.com/yallego/migrations:REPLACE_WITH_RELEASE
DASHBOARD_IMAGE=registry.example.com/yallego/dashboard:REPLACE_WITH_RELEASE
PROXY_IMAGE=registry.example.com/yallego/proxy:REPLACE_WITH_RELEASE

# PostgreSQL. Use valores URL-safe porque las credenciales forman parte de las
# URLs de conexión internas creadas por Compose.
POSTGRES_DB=yallego
POSTGRES_SUPERUSER=yallego
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_VALUE
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_URL_SAFE_VALUE

# Producción exige estas claves. Genere el par JWT con
# tools/scripts/generate-jwt-keys.sh y guarde sus valores base64 en el gestor de
# secretos del servidor; nunca confirme el archivo real.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ENCRYPTION_KEY=
DEPLOY_LOG_LEVEL=info

# Integraciones del ambiente
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=no-reply@example.com
PLATFORM_ALLOWED_IPS=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

