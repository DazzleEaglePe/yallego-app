logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "yallego" {
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "5s"
}

discovery.relabel "yallego" {
  targets = discovery.docker.yallego.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "yallego-.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "yallego" {
  host       = "tcp://docker-socket-proxy:2375"
  targets    = discovery.relabel.yallego.output
  forward_to = [loki.process.yallego.receiver]
}

loki.process "yallego" {
  stage.docker {}

  stage.static_labels {
    values = {
      environment = sys.env("DEPLOY_ENV"),
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
