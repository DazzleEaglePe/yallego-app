        "includeAll": true,
        "label": "Servicio en logs",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values({compose_project=~\"yallego-.*\"}, service)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
