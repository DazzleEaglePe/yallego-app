map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# DNS embebido de Docker. `resolve` permite descubrir candidatos blue/green y
# reemplazos de contenedor sin reiniciar el proxy ni conservar una IP obsoleta.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 3s;

upstream yallego_api {
  zone yallego_api 64k;
  server api:3001 resolve;
  keepalive 32;
}

upstream yallego_dashboard {
  zone yallego_dashboard 64k;
  server dashboard:3000 resolve;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name ${SERVER_NAME};

  return 308 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${SERVER_NAME};

  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:YallegoTLS:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 2m;
  proxy_hide_header X-Powered-By;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;

  location = /edge-health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Superficies HTTP y Socket.IO del backend. Los encabezados Upgrade son
  # inocuos para REST y permiten que /v1/realtime cambie a WebSocket.
  location ~ ^/(v1|internal/v1|platform/v1)(?:/|$) {
    proxy_pass http://yallego_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
  }

  location / {
    proxy_pass http://yallego_dashboard;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }
}
